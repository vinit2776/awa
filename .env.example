# Copy to .env.local for local development. Real values live in Vercel's
# environment variable settings, never committed here — see SETUP.md.

# Postgres — pooled (Supavisor transaction mode) connection as the
# restricted app_runtime role. RLS applies to this role in full — this is
# what the app runtime uses, always.
DATABASE_URL=
# Pooled connection as the table-OWNER role (postgres.<ref>). RLS does not
# apply to table owners — this is for migrations only (supabase db push,
# drizzle.config.ts), never imported by application code.
DATABASE_URL_MIGRATIONS=

# WorkOS — https://dashboard.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# 32+ char secret used to encrypt the AuthKit session cookie — generate with
# `openssl rand -base64 32`, not a value you choose or reuse.
WORKOS_COOKIE_PASSWORD=
# Must exactly match a Redirect URI registered in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Cloudflare R2 — object storage for documents
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`.
# The public key must be NEXT_PUBLIC_-prefixed (the client needs it for
# pushManager.subscribe()); the private key signs outgoing push messages
# server-side and must never reach the client. VAPID_SUBJECT is a
# mailto: or https: URL identifying who's sending, per the Web Push spec.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# AES-256-GCM key for vendor_bank_accounts.account_number_enc — generate
# with `openssl rand -base64 32`, not a value you choose or reuse.
# Rotating this key makes every previously-encrypted account number
# undecryptable, so treat it like a database credential, not a config
# toggle.
BANK_ACCOUNT_ENCRYPTION_KEY=

# HMAC key signing vendor-portal magic-link and session tokens
# (db/vendorAuth.ts) — generate with `openssl rand -base64 32`. Rotating
# this immediately invalidates every outstanding magic link and every
# signed-in vendor session; that's a legitimate way to force a
# vendor-portal-wide sign-out, not just an accident to avoid.
VENDOR_SESSION_SECRET=

# Transactional email — Resend (https://resend.com). Both must be set for mail
# to actually send; with either missing the app logs what it would have sent
# and carries on, which is the supported state for local development.
#
# EMAIL_FROM must use a domain verified in the Resend dashboard — an
# unverified sender is the most common cause of a 403 on send. Format is
# "Name <address@your-domain.com>".
#
# Deliberately NOT set in CI: the test suite exercises the notification paths
# against throwaway fixture addresses, so a key present during a run would fire
# live email at every address the fixtures invent (db/email.ts suppresses sends
# under vitest as a second guard).
RESEND_API_KEY=
EMAIL_FROM=
