# Copy to .env.local for local development. Real values live in Vercel's
# environment variable settings, never committed here — see SETUP.md.

# Postgres — pooled (Supavisor transaction mode) connection as the
# restricted app_runtime role. RLS applies to this role in full — this is
# what the app runtime uses, always.
DATABASE_URL=
# Pooled connection as the table-OWNER role (postgres.<ref>). RLS does not
# apply to table owners — this is for migrations only (supabase db push,
# drizzle.config.ts), never imported by application code.
DATABASE_URL_MIGRATIONS=

# WorkOS — https://dashboard.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# 32+ char secret used to encrypt the AuthKit session cookie — generate with
# `openssl rand -base64 32`, not a value you choose or reuse.
WORKOS_COOKIE_PASSWORD=
# Must exactly match a Redirect URI registered in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Cloudflare R2 — object storage for documents
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Web Push (VAPID) — generated once, phase 2
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
